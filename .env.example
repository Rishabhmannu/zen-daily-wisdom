# Copy to `.env` and fill in (never commit `.env`).
# Gemini — Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=

# Optional: daily cap (see IMPLEMENTATION_PLAN.md)
# GEMINI_DAILY_CALL_CAP=20
#
# Test (bash; never put the key in the command string):
#   set -a && source .env && set +a
#   curl "https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-latest:generateContent" \
#     -H 'Content-Type: application/json' \
#     -H "X-goog-api-key: ${GEMINI_API_KEY}" \
#     -d '{"contents":[{"parts":[{"text":"Hi"}]}]}'
#
# Gmail API OAuth (Desktop) — from Cloud Console or downloaded client JSON
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=  # from one-time local OAuth
GMAIL_FROM_ADDRESS=   # your sending Gmail address

# Google Calendar OAuth (Desktop)
# If using the same OAuth client JSON as Gmail, you can reuse it.
GCAL_CLIENT_ID=
GCAL_CLIENT_SECRET=
GCAL_REFRESH_TOKEN=      # from one-time local OAuth
GCAL_CALENDAR_ID=        # choose one from oauth_setup_calendar.py output

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
TELEGRAM_WEBHOOK_SECRET=

# Supabase
SUPABASE_URL=
# Frontend-safe public key (Supabase "publishable" / anon key)
SUPABASE_ANON_KEY=
# Backend-only privileged key (Supabase "secret"/service-role key)
SUPABASE_SERVICE_ROLE_KEY=
# Your Supabase Auth user UUID (owner/admin user)
OWNER_UID=
# Comma-separated dashboard allowlist emails
ALLOWED_EMAILS=
SUPABASE_DB_DSN_DIRECT=
SUPABASE_DB_DSN_POOLER=
# Active DSN that app/scripts should use
SUPABASE_DB_DSN=

# Internal security
INTERNAL_HMAC_SECRET=
FEEDBACK_LINK_SECRET=

# Frontend/backend local wiring
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_ALLOWED_EMAILS=
BACKEND_PORT=8000
ENVIRONMENT=development
