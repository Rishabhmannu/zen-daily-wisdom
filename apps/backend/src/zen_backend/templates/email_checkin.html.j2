<!doctype html>
<html lang="en">
  <body style="margin:0; background:#b7ab9b; color:#332f2c; font-family:Arial,Helvetica,sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="padding:38px 0; background:#b7ab9b;">
      <tr>
        <td align="center">
          <table role="presentation" width="620" cellpadding="0" cellspacing="0" style="max-width:620px; background:#e9ddd1; border:1px solid #d9cab9; border-radius:4px;">
            <tr>
              <td style="padding:26px 34px 8px;">
                <p style="margin:0; font-size:12px; letter-spacing:0.16em; color:#756c62;">ZEN CHECK-IN</p>
                <h1 style="margin:10px 0 0; color:#2f2a26; font-size:40px; line-height:1.05; font-weight:500;">{{ window_title }} reflection</h1>
              </td>
            </tr>
            <tr>
              <td style="padding:6px 34px 8px;">
                <p style="margin:0; color:#6f665d; font-size:12px; letter-spacing:0.13em; text-transform:uppercase;">A 60-second check-in</p>
                <p style="line-height:1.7; margin:9px 0 18px; font-size:18px; color:#3a332e; font-weight:400;">
                  {{ intro_line }}
                </p>
                <p style="margin:0 0 6px; color:#5e564e; font-size:14px;">
                  Eight quick questions, each on a 1–5 scale. No login. The link below is yours.
                </p>
              </td>
            </tr>
            <tr>
              <td style="padding:14px 34px 6px;">
                <table role="presentation" cellpadding="0" cellspacing="0" style="background:#f1e6d8; border:1px solid #d9cab9; border-radius:14px; padding:18px 18px 16px; width:100%;">
                  <tr>
                    <td>
                      <p style="margin:0 0 6px; color:#6f665d; font-size:11px; letter-spacing:0.12em; text-transform:uppercase;">What you'll be asked</p>
                      <p style="margin:0; line-height:1.7; color:#3a332e; font-size:14px;">
                        Sleep · Energy · Focus · Stress · Day-load · Motivation · Positivity · Clarity
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td style="padding:18px 34px 8px;" align="left">
                <a
                  href="{{ checkin_url }}"
                  style="display:inline-block; background:#2f5b4f; color:#ffffff; text-decoration:none; font-size:15px; padding:13px 22px; border-radius:999px; font-weight:600;"
                >
                  Begin Check-in
                </a>
                <p style="margin:14px 0 0; color:#7a7269; font-size:12px;">
                  Link expires in 36 hours. If it doesn't open, just paste it into your browser.
                </p>
              </td>
            </tr>
            <tr>
              <td style="padding:18px 34px 26px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                  <tr>
                    <td align="left">
                      <span style="display:inline-block; width:48px; height:48px; border-radius:28px 24px 30px 26px; background:#cb9366;"></span>
                    </td>
                    <td align="center">
                      <span style="display:inline-block; width:18px; height:18px; border-radius:999px; background:#3a312a;"></span>
                    </td>
                    <td align="right">
                      <span style="display:inline-block; width:86px; height:42px; border-radius:46px; border:8px solid #ece2d7; box-sizing:border-box;"></span>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
